# Environment overrides for Windows (MSYS2/UCRT64).
# Sourced by ~/.env at the end of each shell session.

# Normalise an inherited non-UCRT64 MSYS2 subsystem mount (e.g. a parent
# process launched with PATH="/mingw64/bin:..."). Anchored to the path's
# leading component so it can't also mangle an unrelated path that merely
# contains one of these words, such as Git for Windows' bundled
# "/c/Program Files/Git/mingw64/bin".
_normalize_ucrt64_path() {
  local IFS=: _new= _p _sub
  for _p in $PATH; do
    for _sub in mingw64 mingw32 clang64 clang32 clangarm64; do
      case "$_p" in
        "/$_sub"|"/$_sub/"*) _p="/ucrt64${_p#/$_sub}" ;;
      esac
    done
    _new="${_new:+$_new:}$_p"
  done
  PATH=$_new
}
_normalize_ucrt64_path
unset -f _normalize_ucrt64_path

# MSYS2 subsystem identity (UCRT64 runtime).
MSYSTEM=UCRT64
MINGW_PREFIX=/ucrt64
MSYSTEM_PREFIX=/ucrt64
MSYSTEM_CARCH=x86_64
MSYSTEM_CHOST=x86_64-w64-mingw32

# Always create genuine NTFS symlinks. Without this, MSYS2 can fall back to
# a non-native symlink (or a plain copy) depending on the machine's
# privilege state, which breaks anything that resolves its own symlink.
MSYS=winsymlinks:nativestrict

# Convert SHELL to a Windows path so native tools can reliably find it.
SHELL="$(cygpath -m "$SHELL")"

if [ -f "$HOME/.vsdevenv.sh" ]; then
  . "$HOME/.vsdevenv.sh"
fi

# WSL interop
HOST___HOME=$HOME
HOST___PROGRAMFILES=$PROGRAMFILES
WSLENV=HOST___HOME/p:HOST___PROGRAMFILES/p
