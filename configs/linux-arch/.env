# Environment variables for linux-arch.
# Sourced by .zshrc/.bashrc via: set -a; source ~/.env; set +a

# System
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
COLORTERM=truecolor
TERM_PROGRAM=alacritty

# Editor
VISUAL=hx
EDITOR=$VISUAL

# Go
GOPATH=$HOME/.local/share/go
GOMODCACHE=$HOME/.cache/go/mod

# Platform-specific overrides. Not tracked, each machine provides its own.
[ -f "$HOME/.env.local" ] && source "$HOME/.env.local"

