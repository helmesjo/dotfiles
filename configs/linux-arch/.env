# Environment variables for linux-arch.
# Sourced by .zshrc/.bashrc via: set -a; source ~/.env; set +a

# Ensure non-interactive subshells source this environment.
ENV="$HOME/.profile"
BASH_ENV="$HOME/.profile"

# System
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
COLORTERM=truecolor
TERM_PROGRAM=alacritty
SHELL=${SHELL:-$(which bash)} # reasonable fallback if unset

# Editor
VISUAL=hx
EDITOR=$VISUAL

# Go
GOPATH=$HOME/.local/share/go
GOMODCACHE=$HOME/.cache/go/mod

# Platform-specific overrides.
[ -f "$HOME/.env.local" ] && source "$HOME/.env.local"
